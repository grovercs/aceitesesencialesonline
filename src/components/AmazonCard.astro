---
export interface Props {
  title: string;
  description: string;
  image: string;
  link: string;
  buttonText?: string;
}

const {
  title,
  description,
  image,
  link,
  buttonText = 'Ver en Amazon',
} = Astro.props;

const safeLink = link.startsWith('http') ? link : `https://${link}`;
---

<article
  class="amazon-card not-prose my-6 flex flex-col gap-4 rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:flex-row"
  aria-label={`Producto recomendado: ${title}`}
>
  <div class="flex-shrink-0">
    <img
      src={image}
      alt={title}
      width="150"
      height="150"
      loading="lazy"
      decoding="async"
      class="rounded-lg object-cover"
    />
  </div>
  <div class="flex flex-1 flex-col justify-between">
    <div>
      <h3 class="text-lg font-bold text-gray-900">{title}</h3>
      <p class="mt-1 text-sm leading-relaxed text-gray-600">{description}</p>
    </div>
    <div class="mt-3">
      <a
        href={safeLink}
        class="inline-flex items-center rounded-lg bg-[#ff9900] px-5 py-2.5 text-sm font-semibold text-gray-900 transition hover:bg-[#e68a00]"
        target="_blank"
        rel="nofollow sponsored noopener"
        data-affiliate="amazon"
      >
        {buttonText}
        <svg
          class="ml-2 h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
      <p class="mt-2 text-xs text-gray-400">Enlace de afiliado. Comprar puede generarnos una comisión sin coste extra para ti.</p>
    </div>
  </div>
</article>
