---
export interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
}

const { title, description, href, icon } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-green-300 hover:shadow-md"
>
  <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-green-100 text-2xl">
    {icon}
  </div>
  <h3 class="text-xl font-bold text-gray-900 group-hover:text-green-700">{title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-gray-600">{description}</p>
  <span class="mt-4 inline-flex items-center text-sm font-semibold text-green-700">
    Explorar
    <svg class="ml-1 h-4 w-4 transition group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
    </svg>
  </span>
</a>
