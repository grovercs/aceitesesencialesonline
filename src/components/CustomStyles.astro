---
import '@fontsource-variable/inter';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/400-italic.css';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable', sans-serif;
    --aw-font-serif: 'Playfair Display', serif;
    --aw-font-heading: 'Playfair Display', serif;

    /* Primary & Secondary: Organic Sage & Forest Green */
    --aw-color-primary: rgb(34 100 72);
    --aw-color-secondary: rgb(46 125 90);
    /* Accent: Warm Amber & Crafted Gold */
    --aw-color-accent: rgb(200 150 62);

    --aw-color-text-heading: rgb(24 55 42);
    --aw-color-text-default: rgb(45 58 52);
    --aw-color-text-muted: rgb(75 92 84);
    /* Organic Linen Soft Cream Background */
    --aw-color-bg-page: rgb(250 248 244);

    ::selection {
      background-color: rgb(232 216 182);
      color: rgb(24 55 42);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable', sans-serif;
    --aw-font-serif: 'Playfair Display', serif;
    --aw-font-heading: 'Playfair Display', serif;

    --aw-color-primary: rgb(74 180 135);
    --aw-color-secondary: rgb(90 195 148);
    --aw-color-accent: rgb(229 169 60);

    --aw-color-text-heading: rgb(244 241 234);
    --aw-color-text-default: rgb(220 226 222);
    --aw-color-text-muted: rgb(155 172 164);
    /* Deep Forest Slate Background */
    --aw-color-bg-page: rgb(13 23 18);

    ::selection {
      background-color: rgb(34 100 72);
      color: rgb(244 241 234);
    }
  }
</style>
