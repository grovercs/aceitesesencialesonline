---
export interface Props {
  title: string;
  subtitle: string;
  ctaText: string;
  ctaHref: string;
  secondaryText?: string;
  secondaryHref?: string;
}

const { title, subtitle, ctaText, ctaHref, secondaryText, secondaryHref } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-green-50 to-emerald-100 py-20">
  <div class="container mx-auto max-w-6xl px-4 text-center">
    <h1 class="mx-auto max-w-4xl text-4xl font-extrabold tracking-tight text-gray-900 md:text-6xl">
      {title}
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-gray-700 md:text-xl">
      {subtitle}
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={ctaHref}
        class="rounded-xl bg-green-700 px-8 py-3.5 text-base font-semibold text-white shadow-lg transition hover:bg-green-800"
      >
        {ctaText}
      </a>
      {
        secondaryText && secondaryHref && (
          <a
            href={secondaryHref}
            class="rounded-xl border border-green-700 bg-white px-8 py-3.5 text-base font-semibold text-green-700 transition hover:bg-green-50"
          >
            {secondaryText}
          </a>
        )
      }
    </div>
  </div>
</section>
