---
export interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const {
  title = 'Recibe nuestras guías en tu correo',
  description = 'Un email al mes con artículos destacados, novedades del nicho y consejos prácticos. Sin spam.',
  class: className = '',
} = Astro.props;
---

<aside class:list={['not-prose rounded-2xl bg-green-50 p-6 md:p-8', className]}>
  <h3 class="text-xl font-bold text-gray-900">{title}</h3>
  <p class="mt-2 text-sm text-gray-600">{description}</p>

  <form
    name="newsletter"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    action="/gracias-newsletter/"
    class="mt-5 flex flex-col gap-3 sm:flex-row"
  >
    <input type="hidden" name="form-name" value="newsletter" />
    <div hidden>
      <input name="bot-field" />
    </div>

    <label for="newsletter-email" class="sr-only">Correo electrónico</label>
    <input
      id="newsletter-email"
      type="email"
      name="email"
      placeholder="tu@email.com"
      required
      class="flex-1 rounded-xl border border-gray-300 px-4 py-3 text-sm focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-200"
    />

    <button
      type="submit"
      class="rounded-xl bg-green-700 px-6 py-3 text-sm font-semibold text-white transition hover:bg-green-800"
    >
      Suscribirme
    </button>
  </form>

  <p class="mt-3 text-xs text-gray-500">
    Al suscribirte aceptas recibir comunicaciones de {Astro.site?.hostname ?? 'nuestro sitio'}. Puedes
    darte de baja en cualquier momento.
  </p>
</aside>
