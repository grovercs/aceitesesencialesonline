---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, category, image, alt } = post.data;
const coverImage = typeof image === 'string' ? image : image.src;

const formattedDate = pubDate.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const categorySlug = category.toLowerCase().replace(/\s+/g, '-');
---

<article class="group flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition hover:shadow-md">
  <a href={`/blog/${post.id}/`} class="block overflow-hidden">
    <img
      src={coverImage}
      alt={alt}
      width="800"
      height="420"
      loading="lazy"
      decoding="async"
      class="h-48 w-full object-cover transition duration-300 group-hover:scale-105"
    />
  </a>
  <div class="flex flex-1 flex-col p-5">
    <div class="mb-2 flex items-center justify-between">
      <a
        href={`/categorias/${categorySlug}/`}
        class="rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800"
      >
        {category}
      </a>
      <time class="text-xs text-gray-500" datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>
    <h2 class="mb-2 text-xl font-bold leading-tight text-gray-900">
      <a href={`/blog/${post.id}/`} class="hover:text-green-700">{title}</a>
    </h2>
    <p class="flex-1 text-sm leading-relaxed text-gray-600">{description}</p>
    <div class="mt-4">
      <a
        href={`/blog/${post.id}/`}
        class="text-sm font-semibold text-green-700 hover:text-green-800"
      >
        Leer artículo →
      </a>
    </div>
  </div>
</article>
