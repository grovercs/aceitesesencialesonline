---
import { slugify } from '../utils/content';

export interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <a
          href={`/etiquetas/${slugify(tag)}/`}
          class="rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700 transition hover:bg-green-100 hover:text-green-800"
        >
          #{tag}
        </a>
      ))}
    </div>
  )
}
