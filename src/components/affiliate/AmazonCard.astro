---
export interface Props {
  title: string;
  description?: string;
  image: string;
  link: string;
  price?: string;
  rating?: number;
  reviews?: number;
  buttonText?: string;
}

const { title, description, image, link, price, rating, reviews, buttonText = 'Ver en Amazon' } = Astro.props;

const safeLink = link.startsWith('http') ? link : `https://${link}`;
const safeImage = image || 'https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?auto=format&fit=crop&w=300&q=80';
const roundedRating = rating ? Math.round(rating * 10) / 10 : undefined;
---

<article
  class="amazon-card not-prose my-8 flex flex-col gap-5 rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:flex-row"
  aria-label={`Producto recomendado: ${title}`}
>
  <div class="flex-shrink-0">
    <img
      src={safeImage}
      alt={title}
      width="150"
      height="150"
      loading="lazy"
      decoding="async"
      class="rounded-lg object-cover"
    />
  </div>
  <div class="flex flex-1 flex-col justify-between">
    <div>
      <h3 class="text-lg font-bold text-gray-900 dark:text-white">{title}</h3>
      {description && <p class="mt-1 text-sm leading-relaxed text-gray-600 dark:text-slate-300">{description}</p>}

      {
        (price || roundedRating) && (
          <div class="mt-2 flex flex-wrap items-center gap-3 text-sm">
            {price && (
              <span class="font-semibold text-green-700 dark:text-green-400" aria-label={`Precio: ${price}`}>
                {price}
              </span>
            )}
            {roundedRating && (
              <span class="inline-flex items-center text-yellow-600 dark:text-yellow-400" aria-label={`Valoración: ${roundedRating} de 5`}>
                <svg class="mr-1 h-4 w-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                {roundedRating}
                {reviews && <span class="ml-1 text-gray-500 dark:text-slate-400">({reviews?.toLocaleString('es-ES')})</span>}
              </span>
            )}
          </div>
        )
      }
    </div>
    <div class="mt-3">
      <a
        href={safeLink}
        class="inline-flex items-center rounded-lg bg-[#ff9900] px-5 py-2.5 text-sm font-semibold text-gray-900 transition hover:bg-[#e68a00]"
        target="_blank"
        rel="nofollow sponsored noopener"
        data-affiliate="amazon"
      >
        {buttonText}
        <svg
          class="ml-2 h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
      <p class="mt-2 text-xs text-gray-400 dark:text-slate-400">
        Enlace de afiliado. Comprar puede generarnos una comisión sin coste extra para ti.
      </p>
    </div>
  </div>
</article>
