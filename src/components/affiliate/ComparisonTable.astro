---
export interface ProductItem {
  name: string;
  badge?: string;
  image: string;
  summary: string;
  rating?: number;
  price?: string;
  link: string;
  isFeatured?: boolean;
}

export interface Props {
  title?: string;
  subtitle?: string;
  products: ProductItem[];
}

const {
  title = 'Tabla Comparativa de Productos Recomendados',
  subtitle = 'Análisis rápido de las mejores opciones según su uso y relación calidad-precio.',
  products = [],
} = Astro.props;
---

<div
  class="not-prose my-10 overflow-hidden rounded-2xl border border-amber-200/60 bg-white/90 shadow-sm backdrop-blur-sm dark:border-slate-700/80 dark:bg-slate-800/80"
>
  {
    (title || subtitle) && (
      <div class="border-b border-gray-100 bg-amber-50/50 p-5 dark:border-slate-700/60 dark:bg-slate-900/40">
        {title && <h3 class="font-heading text-xl font-bold text-slate-900 dark:text-white sm:text-2xl">{title}</h3>}
        {subtitle && <p class="mt-1 text-xs text-slate-600 dark:text-slate-400 sm:text-sm">{subtitle}</p>}
      </div>
    )
  }

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs sm:text-sm">
      <thead
        class="border-b border-gray-100 bg-slate-50/70 text-slate-700 dark:border-slate-700 dark:bg-slate-900/80 dark:text-slate-300"
      >
        <tr>
          <th scope="col" class="py-3.5 px-4 font-semibold">Producto</th>
          <th scope="col" class="hidden py-3.5 px-4 font-semibold md:table-cell">Características Destacadas</th>
          <th scope="col" class="py-3.5 px-4 font-semibold text-center">Valoración</th>
          <th scope="col" class="py-3.5 px-4 font-semibold text-center">Precio aprox.</th>
          <th scope="col" class="py-3.5 px-4 font-semibold text-right">Comprar</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-slate-700/60">
        {
          products.map((item) => (
            <tr
              class={
                item.isFeatured
                  ? 'bg-amber-50/30 dark:bg-amber-950/20 font-medium'
                  : 'hover:bg-slate-50/50 dark:hover:bg-slate-700/30'
              }
            >
              <td class="py-4 px-4">
                <div class="flex items-center gap-3">
                  <div class="h-16 w-16 flex-shrink-0 overflow-hidden rounded-xl border border-gray-100 bg-white p-1 dark:border-slate-700 dark:bg-slate-900 flex items-center justify-center">
                    <img src={item.image} alt={item.name} class="max-h-14 w-auto object-contain" />
                  </div>
                  <div>
                    {item.badge && (
                      <span class="mb-1 inline-block rounded-full bg-amber-500/10 px-2 py-0.5 text-[10px] font-bold text-amber-700 dark:bg-amber-400/20 dark:text-amber-300 uppercase tracking-wider">
                        {item.badge}
                      </span>
                    )}
                    <a
                      href={item.link.startsWith('http') ? item.link : `https://${item.link}`}
                      target="_blank"
                      rel="nofollow sponsored noopener"
                      class="font-bold text-slate-900 hover:text-amber-600 dark:text-white dark:hover:text-amber-400 line-clamp-2"
                    >
                      {item.name}
                    </a>
                  </div>
                </div>
              </td>
              <td class="hidden py-4 px-4 text-xs text-slate-600 dark:text-slate-300 md:table-cell max-w-xs">
                {item.summary}
              </td>
              <td class="py-4 px-4 text-center">
                {item.rating ? (
                  <span class="inline-flex items-center gap-1 rounded-md bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-700 dark:bg-amber-950/50 dark:text-amber-300 border border-amber-200/50 dark:border-amber-900/50">
                    ★ {item.rating}
                  </span>
                ) : (
                  <span class="text-slate-400">—</span>
                )}
              </td>
              <td class="py-4 px-4 text-center font-bold text-emerald-700 dark:text-emerald-400">
                {item.price || 'Consultar'}
              </td>
              <td class="py-4 px-4 text-right">
                <a
                  href={item.link.startsWith('http') ? item.link : `https://${item.link}`}
                  target="_blank"
                  rel="nofollow sponsored noopener"
                  class="inline-flex items-center gap-1 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 px-3.5 py-2 text-xs font-bold text-slate-950 shadow-sm transition hover:from-amber-500 hover:to-amber-600 active:scale-95"
                >
                  <span>Ver oferta</span>
                  <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                    />
                  </svg>
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>
