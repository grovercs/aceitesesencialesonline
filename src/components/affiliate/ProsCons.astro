---
export interface Props {
  pros: string[];
  cons: string[];
  title?: string;
}

const { pros = [], cons = [], title = 'Pros y Contras' } = Astro.props;
---

<div class="not-prose my-8 rounded-2xl border border-slate-200/80 bg-white/80 p-5 shadow-sm dark:border-slate-700/80 dark:bg-slate-800/80">
  {title && <h4 class="mb-4 font-heading text-lg font-bold text-slate-900 dark:text-white">{title}</h4>}
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <!-- Pros -->
    <div class="rounded-xl border border-emerald-200/70 bg-emerald-50/40 p-4 dark:border-emerald-900/50 dark:bg-emerald-950/20">
      <div class="mb-3 flex items-center gap-2 font-bold text-emerald-800 dark:text-emerald-300">
        <div class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-500 text-white shadow-xs">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <span>Ventajas principales</span>
      </div>
      <ul class="space-y-2 text-xs text-slate-700 dark:text-slate-300">
        {pros.map((item) => (
          <li class="flex items-start gap-2">
            <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-emerald-500"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Cons -->
    <div class="rounded-xl border border-amber-200/70 bg-amber-50/40 p-4 dark:border-amber-900/50 dark:bg-amber-950/20">
      <div class="mb-3 flex items-center gap-2 font-bold text-amber-800 dark:text-amber-300">
        <div class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-500 text-white shadow-xs">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
        <span>A tener en cuenta</span>
      </div>
      <ul class="space-y-2 text-xs text-slate-700 dark:text-slate-300">
        {cons.map((item) => (
          <li class="flex items-start gap-2">
            <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-amber-500"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>
