---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article
  class="group flex flex-col bg-white dark:bg-slate-800/90 rounded-2xl border border-slate-200/80 dark:border-slate-700/80 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden h-full intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
>
  <div class="relative w-full h-52 sm:h-56 overflow-hidden bg-slate-100 dark:bg-slate-900">
    {
      image &&
        (link ? (
          <a href={link} class="block w-full h-full">
            <Image
              src={image}
              class="w-full h-full object-contain p-2 bg-slate-50 dark:bg-slate-900/50 group-hover:scale-105 transition-transform duration-500 ease-out"
              widths={[400, 900]}
              width={900}
              height={506}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.title}
              format="webp"
              loading="lazy"
              decoding="async"
            />
          </a>
        ) : (
          <Image
            src={image}
            class="w-full h-full object-contain p-2 bg-slate-50 dark:bg-slate-900/50"
            widths={[400, 900]}
            width={900}
            height={506}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.title}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        ))
    }
    {
      post.category && (
        <div class="absolute top-3 left-3 z-10">
          <span class="inline-block px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider bg-amber-500 text-slate-950 rounded-full shadow-xs">
            {post.category.title}
          </span>
        </div>
      )
    }
  </div>

  <div class="p-5 flex flex-col flex-1 justify-between">
    <div>
      <div class="text-xs text-slate-400 dark:text-slate-400 mb-2 flex items-center gap-2">
        <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
        {post.readingTime && <span>· {post.readingTime} min de lectura</span>}
      </div>

      <h3 class="text-base sm:text-lg font-bold font-heading text-slate-900 dark:text-white leading-snug group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors mb-2 line-clamp-2">
        {
          link ? (
            <a href={link}>
              {post.title}
            </a>
          ) : (
            post.title
          )
        }
      </h3>

      {post.excerpt && (
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed font-normal">
          {post.excerpt}
        </p>
      )}
    </div>

    <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-700/60 flex items-center justify-between">
      <a href={link} class="text-xs font-semibold text-amber-700 dark:text-amber-400 group-hover:underline inline-flex items-center gap-1">
        Leer guía completa →
      </a>
    </div>
  </div>
</article>
