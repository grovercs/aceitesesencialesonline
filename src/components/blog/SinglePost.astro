---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import Comments from '~/components/common/Comments.astro';
import AffiliateDisclosure from '~/components/common/AffiliateDisclosure.astro';
import AuthorBox from '~/components/common/AuthorBox.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

<section class="py-6 sm:py-10 max-w-4xl mx-auto px-4 sm:px-6">
  <article>
    <header class="max-w-3xl mx-auto text-center mb-8">
      <div
        class="mb-3 text-xs sm:text-sm text-slate-500 dark:text-slate-400 flex items-center justify-center gap-2 flex-wrap"
      >
        <span class="inline-flex items-center gap-1">
          <Icon name="tabler:clock" class="w-3.5 h-3.5 inline-block -mt-0.5" />
          <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
        </span>
        {
          post.author && (
            <>
              ·{' '}
              <span class="inline-flex items-center gap-1">
                <Icon name="tabler:user" class="w-3.5 h-3.5 inline-block -mt-0.5" />
                <span>{post.author}</span>
              </span>
            </>
          )
        }
        {
          post.category && (
            <>
              ·{' '}
              <a
                class="hover:underline font-semibold text-amber-600 dark:text-amber-400"
                href={getPermalink(post.category.slug, 'category')}
              >
                {post.category.title}
              </a>
            </>
          )
        }
        {
          post.readingTime && (
            <>
              · <span>{post.readingTime} min de lectura</span>
            </>
          )
        }
      </div>

      <h1
        class="text-2xl sm:text-3xl md:text-4xl font-bold font-heading text-slate-900 dark:text-white leading-tight tracking-tight mb-4"
      >
        {post.title}
      </h1>

      {
        post.excerpt && (
          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-normal leading-relaxed max-w-2xl mx-auto">
            {post.excerpt}
          </p>
        )
      }
    </header>

    {
      post.image ? (
        <div class="max-w-3xl mx-auto mb-6 overflow-hidden rounded-2xl shadow-sm border border-slate-100 dark:border-slate-800/80 bg-slate-50 dark:bg-slate-900/50 p-2">
          <Image
            src={post.image}
            class="w-full h-auto max-h-[520px] !object-contain mx-auto block"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post?.excerpt || post.title}
            width={900}
            format="webp"
            loading="eager"
            decoding="async"
          />
        </div>
      ) : (
        <div class="max-w-3xl mx-auto mb-6 border-t border-slate-200 dark:border-slate-700/60" />
      )
    }

    <div class="max-w-3xl mx-auto">
      <AffiliateDisclosure />
    </div>

    <div
      class="mx-auto max-w-3xl prose prose-slate lg:prose-lg dark:prose-invert prose-headings:font-heading prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-slate-900 dark:prose-headings:text-slate-100 prose-p:text-slate-700 dark:prose-p:text-slate-300 prose-p:leading-relaxed prose-a:text-amber-600 dark:prose-a:text-amber-400 prose-img:rounded-2xl prose-img:shadow-sm prose-headings:scroll-mt-[80px]"
    >
      <slot />
    </div>

    <div class="max-w-3xl mx-auto">
      <AuthorBox />
    </div>

    <div
      class="mx-auto max-w-3xl mt-6 pt-6 border-t border-slate-200 dark:border-slate-800 flex justify-between flex-col sm:flex-row gap-4"
    >
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="mt-2 sm:mt-0 align-middle text-slate-500 dark:text-slate-400" />
    </div>

    <div class="mx-auto max-w-3xl">
      <Comments />
    </div>
  </article>
</section>
