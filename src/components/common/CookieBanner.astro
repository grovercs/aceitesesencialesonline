---
---

<style>
  /* El banner empieza visible con animación de entrada */
  #cookie-banner-wrap {
    animation: cookie-slide-up 0.4s ease-out both;
  }
  @keyframes cookie-slide-up {
    from { transform: translateY(120%); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
  }
  /* Clase para ocultarlo (solo JS la añade) */
  .ck-hidden {
    display: none !important;
  }
  /* El trigger empieza oculto */
  #cookie-trigger-btn {
    display: none;
  }
</style>

<!-- Botón flotante para reabrir (esquina inferior derecha) -->
<button
  id="cookie-trigger-btn"
  transition:persist
  class="fixed bottom-5 right-5 z-[9998] flex cursor-pointer items-center gap-2 rounded-full border border-gray-200 bg-white/95 px-4 py-2.5 text-xs font-semibold text-gray-700 shadow-xl backdrop-blur-md transition-all hover:scale-105 hover:shadow-2xl dark:border-slate-700 dark:bg-slate-900/95 dark:text-slate-200"
  title="Gestionar consentimiento de cookies"
>
  <span>🍪</span>
  <span>Gestionar consentimiento</span>
</button>

<!-- Banner principal: VISIBLE por defecto, JS lo oculta si ya hay consentimiento -->
<div
  id="cookie-banner-wrap"
  transition:persist
  class="fixed inset-x-4 bottom-5 z-[9999] mx-auto max-w-6xl"
>
  <div class="rounded-2xl border border-gray-200/80 bg-white/98 p-5 shadow-2xl backdrop-blur-md dark:border-slate-800/80 dark:bg-slate-900/98 sm:p-6">

    <!-- Fila principal: texto + botones -->
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex-1 space-y-1">
        <h3 class="text-sm font-bold text-gray-900 dark:text-white sm:text-base">
          🍪 Tu privacidad, tus reglas
        </h3>
        <p class="max-w-4xl text-xs leading-relaxed text-gray-600 dark:text-slate-300">
          Utilizamos cookies para mejorar tu experiencia, analizar el tráfico y personalizar contenido. Puedes aceptar todas, rechazarlas o personalizar tu elección en cualquier momento.
        </p>
      </div>

      <div class="flex shrink-0 flex-wrap items-center gap-2 sm:flex-nowrap">
        <button
          id="cookie-btn-reject"
          class="w-full cursor-pointer rounded-xl border border-gray-300 bg-white px-4 py-2.5 text-xs font-semibold text-gray-700 transition-colors hover:bg-gray-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 sm:w-auto"
        >Denegar</button>
        <button
          id="cookie-btn-prefs"
          class="w-full cursor-pointer rounded-xl border border-gray-300 bg-white px-4 py-2.5 text-xs font-semibold text-gray-700 transition-colors hover:bg-gray-50 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 sm:w-auto"
        >Preferencias</button>
        <button
          id="cookie-btn-accept"
          class="w-full cursor-pointer rounded-xl bg-amber-500 px-5 py-2.5 text-xs font-bold text-white shadow-sm transition-colors hover:bg-amber-600 dark:bg-amber-600 dark:hover:bg-amber-700 sm:w-auto"
        >Aceptar</button>
      </div>
    </div>

    <!-- Panel de preferencias (oculto por defecto) -->
    <div id="cookie-prefs-panel" class="ck-hidden mt-5 border-t border-gray-100 pt-5 dark:border-slate-700">
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">

        <!-- Funcional: siempre activo -->
        <div class="flex items-center justify-between rounded-xl bg-gray-50 p-4 dark:bg-slate-800/60">
          <div>
            <p class="text-xs font-bold text-gray-900 dark:text-white">Funcional</p>
            <p class="mt-0.5 text-[10px] text-gray-500 dark:text-slate-400">Estrictamente necesarias</p>
          </div>
          <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">Siempre activo</span>
        </div>

        <!-- Estadísticas -->
        <div class="flex items-center justify-between rounded-xl bg-gray-50 p-4 dark:bg-slate-800/60">
          <div>
            <p class="text-xs font-bold text-gray-900 dark:text-white">Estadísticas</p>
            <p class="mt-0.5 text-[10px] text-gray-500 dark:text-slate-400">Analítica y rendimiento</p>
          </div>
          <label class="relative inline-flex cursor-pointer select-none items-center">
            <input type="checkbox" id="pref-analytics" class="peer sr-only" />
            <div class="peer h-5 w-10 rounded-full bg-gray-300 transition-colors after:absolute after:left-[2px] after:top-[2px] after:h-4 after:w-4 after:rounded-full after:border after:border-gray-300 after:bg-white after:transition-all after:content-[''] peer-checked:bg-amber-500 peer-checked:after:translate-x-full peer-checked:after:border-white dark:bg-slate-600 dark:peer-checked:bg-amber-600"></div>
          </label>
        </div>

        <!-- Marketing -->
        <div class="flex items-center justify-between rounded-xl bg-gray-50 p-4 dark:bg-slate-800/60">
          <div>
            <p class="text-xs font-bold text-gray-900 dark:text-white">Marketing</p>
            <p class="mt-0.5 text-[10px] text-gray-500 dark:text-slate-400">Afiliación y publicidad</p>
          </div>
          <label class="relative inline-flex cursor-pointer select-none items-center">
            <input type="checkbox" id="pref-marketing" class="peer sr-only" />
            <div class="peer h-5 w-10 rounded-full bg-gray-300 transition-colors after:absolute after:left-[2px] after:top-[2px] after:h-4 after:w-4 after:rounded-full after:border after:border-gray-300 after:bg-white after:transition-all after:content-[''] peer-checked:bg-amber-500 peer-checked:after:translate-x-full peer-checked:after:border-white dark:bg-slate-600 dark:peer-checked:bg-amber-600"></div>
          </label>
        </div>
      </div>

      <div class="mt-4 flex justify-end">
        <button
          id="cookie-btn-save"
          class="cursor-pointer rounded-xl bg-amber-500 px-6 py-2.5 text-xs font-bold text-white shadow-sm transition-colors hover:bg-amber-600 dark:bg-amber-600 dark:hover:bg-amber-700"
        >Guardar preferencias</button>
      </div>
    </div>

    <!-- Links legales -->
    <div class="mt-4 flex flex-wrap justify-center gap-x-3 gap-y-1 border-t border-gray-100 pt-3 dark:border-slate-700">
      <a href="/cookies" class="text-[10px] text-gray-500 hover:underline dark:text-slate-400">Política de Cookies</a>
      <span class="text-[10px] text-gray-400">•</span>
      <a href="/privacy" class="text-[10px] text-gray-500 hover:underline dark:text-slate-400">Política de Privacidad</a>
      <span class="text-[10px] text-gray-400">•</span>
      <a href="/terms" class="text-[10px] text-gray-500 hover:underline dark:text-slate-400">Aviso Legal</a>
    </div>
  </div>
</div>

<script>
  function lsGet(k: string): string | null {
    try { return localStorage.getItem(k); } catch { return null; }
  }
  function lsSet(k: string, v: string): void {
    try { localStorage.setItem(k, v); } catch { /* incognito */ }
  }

  function initBanner() {
    const wrap    = document.getElementById('cookie-banner-wrap');
    const trigger = document.getElementById('cookie-trigger-btn');
    const panel   = document.getElementById('cookie-prefs-panel');
    const chkA    = document.getElementById('pref-analytics') as HTMLInputElement | null;
    const chkM    = document.getElementById('pref-marketing') as HTMLInputElement | null;

    if (!wrap || !trigger || !panel || !chkA || !chkM) return;

    // ─── Helpers visuales ──────────────────────────────────────────────────
    // El banner empieza VISIBLE por CSS. JavaScript solo lo OCULTA.
    function hideBanner() {
      wrap.classList.add('ck-hidden');
      panel.classList.add('ck-hidden');
      trigger.style.display = 'flex';
    }
    function showBanner() {
      chkA!.checked = lsGet('ck-analytics') !== 'false';
      chkM!.checked = lsGet('ck-marketing') !== 'false';
      panel.classList.add('ck-hidden');
      wrap.classList.remove('ck-hidden');
      trigger.style.display = 'none';
    }
    function saveAndClose(analytics: boolean, marketing: boolean) {
      lsSet('ck-decided', '1');
      lsSet('ck-analytics', analytics ? 'true' : 'false');
      lsSet('ck-marketing', marketing ? 'true' : 'false');
      hideBanner();
      window.dispatchEvent(new CustomEvent('cookie-consent-updated', {
        detail: { analytics, marketing }
      }));
    }

    // ─── Registrar listeners (onclick no acumula duplicados) ───────────────
    document.getElementById('cookie-btn-accept')!.onclick = () => saveAndClose(true, true);
    document.getElementById('cookie-btn-reject')!.onclick = () => saveAndClose(false, false);
    document.getElementById('cookie-btn-prefs')!.onclick  = () => {
      panel.classList.toggle('ck-hidden');
    };
    document.getElementById('cookie-btn-save')!.onclick   = () => saveAndClose(chkA.checked, chkM.checked);
    trigger.onclick = () => showBanner();

    // ─── Estado inicial ────────────────────────────────────────────────────
    // Si ya existe consentimiento → ocultar banner y mostrar trigger.
    // Si NO existe → el banner ya es visible por CSS (no hace falta hacer nada).
    if (lsGet('ck-decided')) {
      hideBanner();
    } else {
      // Sincronizar checkboxes con valores por defecto
      chkA.checked = true;
      chkM.checked = true;
      trigger.style.display = 'none';
    }
  }

  document.addEventListener('astro:page-load', initBanner);
</script>
