---
---

<!-- Botón flotante para reabrir el consentimiento (situado abajo a mano derecha) -->
<button
  id="btn-cookie-trigger"
  class="fixed bottom-4 right-4 z-40 flex items-center justify-center gap-2 rounded-full border border-gray-200 bg-white/90 px-4 py-2.5 text-xs font-bold text-gray-700 shadow-xl backdrop-blur-sm hover:bg-gray-50 dark:border-slate-800 dark:bg-slate-900/90 dark:text-slate-200 dark:hover:bg-slate-800 transition-all duration-300 hover:scale-105 cursor-pointer"
  title="Gestionar consentimiento de cookies"
>
  <span class="text-sm">🍪</span>
  <span>Gestionar consentimiento</span>
</button>

<!-- Caja/Modal de Consentimiento de Cookies (Diseño premium idéntico a la imagen) -->
<div
  id="cookie-banner"
  class="fixed inset-x-4 bottom-4 z-50 mx-auto w-auto max-w-lg transform rounded-2xl border border-gray-200/80 bg-white p-5 shadow-2xl transition-all duration-500 translate-y-12 opacity-0 hidden dark:border-slate-800/80 dark:bg-slate-900 sm:bottom-6 sm:p-6"
  aria-live="polite"
>
  <!-- Cabecera con Botón de Cierre X -->
  <div class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-slate-800">
    <h3 class="text-sm font-bold text-gray-900 dark:text-white sm:text-base">
      Gestionar el consentimiento de las cookies
    </h3>
    <button
      id="btn-close-cookie-banner"
      class="rounded-lg p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-slate-800 dark:hover:text-white transition-colors cursor-pointer"
      aria-label="Cerrar banner"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Cuerpo de contenido -->
  <div class="mt-4 space-y-4">
    <p class="text-xs text-gray-600 dark:text-slate-300 leading-relaxed">
      Para ofrecer las mejores experiencias, utilizamos tecnologías como las cookies para almacenar y/o acceder a la información del dispositivo. El consentimiento de estas tecnologías nos permitirá procesar datos como el comportamiento de navegación o las identificaciones únicas en este sitio. No consentir o retirar el consentimiento, puede afectar negativamente a ciertas características y funciones.
    </p>

    <!-- Preferencias Granulares Permanentes (Igual que en la captura) -->
    <div class="space-y-2">
      <!-- Funcional (Siempre activo) -->
      <div class="flex items-center justify-between rounded-xl bg-gray-50/80 p-3 dark:bg-slate-800/50">
        <div class="flex flex-col gap-0.5">
          <span class="text-xs font-bold text-gray-900 dark:text-white">Funcional</span>
          <span class="text-[10px] text-gray-500 dark:text-slate-450">Estrictamente necesarias</span>
        </div>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 select-none">Siempre activo</span>
      </div>

      <!-- Estadísticas (Toggle con Label clicable) -->
      <div class="flex items-center justify-between rounded-xl bg-gray-50/80 p-3 dark:bg-slate-800/50">
        <div class="flex flex-col gap-0.5">
          <span class="text-xs font-bold text-gray-900 dark:text-white">Estadísticas</span>
          <span class="text-[10px] text-gray-500 dark:text-slate-455">Analítica y rendimiento</span>
        </div>
        <label class="relative inline-flex items-center cursor-pointer select-none">
          <input type="checkbox" id="cookie-opt-analytics" class="sr-only peer" checked />
          <div class="relative w-10 h-5 bg-gray-200 rounded-full peer dark:bg-slate-700 peer-checked:bg-blue-600 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all dark:border-slate-600 peer-checked:after:translate-x-full peer-checked:after:border-white"></div>
        </label>
      </div>

      <!-- Marketing (Toggle con Label clicable) -->
      <div class="flex items-center justify-between rounded-xl bg-gray-50/80 p-3 dark:bg-slate-800/50">
        <div class="flex flex-col gap-0.5">
          <span class="text-xs font-bold text-gray-900 dark:text-white">Marketing</span>
          <span class="text-[10px] text-gray-500 dark:text-slate-455">Afiliación y enlaces</span>
        </div>
        <label class="relative inline-flex items-center cursor-pointer select-none">
          <input type="checkbox" id="cookie-opt-marketing" class="sr-only peer" checked />
          <div class="relative w-10 h-5 bg-gray-200 rounded-full peer dark:bg-slate-700 peer-checked:bg-blue-600 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all dark:border-slate-600 peer-checked:after:translate-x-full peer-checked:after:border-white"></div>
        </label>
      </div>
    </div>
  </div>

  <!-- Botones de Acción (Aceptar | Denegar | Guardar) -->
  <div class="mt-5 grid grid-cols-3 gap-2">
    <button
      id="btn-accept-all-cookies"
      class="rounded-xl bg-blue-600 hover:bg-blue-700 px-3 py-2.5 text-xs font-bold text-white shadow transition-colors cursor-pointer text-center"
    >
      Aceptar
    </button>
    <button
      id="btn-reject-all-cookies"
      class="rounded-xl bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 border border-gray-200 dark:border-slate-700 px-3 py-2.5 text-xs font-bold text-gray-800 dark:text-gray-250 transition-colors cursor-pointer text-center"
    >
      Denegar
    </button>
    <button
      id="btn-save-cookie-prefs"
      class="rounded-xl bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 border border-gray-200 dark:border-slate-700 px-3 py-2.5 text-xs font-bold text-gray-800 dark:text-gray-255 transition-colors cursor-pointer text-center"
    >
      Guardar
    </button>
  </div>

  <!-- Enlaces Legales -->
  <div class="mt-4 flex justify-center gap-3 border-t border-gray-100 pt-3 text-[10px] text-gray-500 dark:border-slate-800 dark:text-slate-400">
    <a href="/cookies" class="hover:underline">Política de Cookies</a>
    <span>•</span>
    <a href="/privacy" class="hover:underline">Política de Privacidad</a>
    <span>•</span>
    <a href="/terms" class="hover:underline">Aviso Legal</a>
  </div>
</div>

<script>
  function initCookieBanner() {
    try {
      const banner = document.getElementById('cookie-banner');
      const trigger = document.getElementById('btn-cookie-trigger');
      const btnClose = document.getElementById('btn-close-cookie-banner');

      const btnAcceptAll = document.getElementById('btn-accept-all-cookies');
      const btnRejectAll = document.getElementById('btn-reject-all-cookies');
      const btnSavePrefs = document.getElementById('btn-save-cookie-prefs');

      const optAnalytics = document.getElementById('cookie-opt-analytics') as HTMLInputElement;
      const optMarketing = document.getElementById('cookie-opt-marketing') as HTMLInputElement;

      if (!banner || !trigger || !btnAcceptAll || !btnRejectAll || !btnSavePrefs || !optAnalytics || !optMarketing) {
        console.warn('Algunos elementos del banner de cookies no se encontraron en el DOM.');
        return;
      }

      // Cargar las preferencias guardadas desde localStorage
      const consentDecided = localStorage.getItem('cookie-consent-decided');
      const consentAnalytics = localStorage.getItem('cookie-consent-analytics');
      const consentMarketing = localStorage.getItem('cookie-consent-marketing');

      // Sincronizar checkboxes con localStorage
      if (consentAnalytics !== null) {
        optAnalytics.checked = consentAnalytics === 'true';
      } else {
        optAnalytics.checked = true;
      }

      if (consentMarketing !== null) {
        optMarketing.checked = consentMarketing === 'true';
      } else {
        optMarketing.checked = true;
      }

      // Mostrar banner o disparador según corresponda
      if (!consentDecided) {
        showBanner();
        trigger.classList.add('hidden');
      } else {
        trigger.classList.remove('hidden');
        banner.classList.add('hidden');
      }

      // Función para guardar consentimiento
      function saveConsent(analyticsVal: boolean, marketingVal: boolean) {
        localStorage.setItem('cookie-consent-decided', 'true');
        localStorage.setItem('cookie-consent-analytics', String(analyticsVal));
        localStorage.setItem('cookie-consent-marketing', String(marketingVal));
        hideBanner();
        trigger.classList.remove('hidden');

        // Disparar evento para scripts como Analytics
        window.dispatchEvent(new CustomEvent('cookie-consent-updated', {
          detail: { analytics: analyticsVal, marketing: marketingVal }
        }));
      }

      function showBanner() {
        // Sincronizar checks antes de mostrar
        const currentAnalytics = localStorage.getItem('cookie-consent-analytics');
        const currentMarketing = localStorage.getItem('cookie-consent-marketing');
        if (currentAnalytics !== null) {
          optAnalytics.checked = currentAnalytics === 'true';
        }
        if (currentMarketing !== null) {
          optMarketing.checked = currentMarketing === 'true';
        }

        banner.classList.remove('hidden');
        trigger.classList.add('hidden');
        setTimeout(() => {
          banner.classList.remove('translate-y-12', 'opacity-0');
          banner.classList.add('translate-y-0', 'opacity-100');
        }, 50);
      }

      function hideBanner() {
        banner.classList.remove('translate-y-0', 'opacity-100');
        banner.classList.add('translate-y-12', 'opacity-0');
        setTimeout(() => {
          banner.classList.add('hidden');
        }, 500);
      }

      // Registro de clics individuales directos
      btnAcceptAll.addEventListener('click', () => {
        optAnalytics.checked = true;
        optMarketing.checked = true;
        saveConsent(true, true);
      });

      btnRejectAll.addEventListener('click', () => {
        optAnalytics.checked = false;
        optMarketing.checked = false;
        saveConsent(false, false);
      });

      btnSavePrefs.addEventListener('click', () => {
        saveConsent(optAnalytics.checked, optMarketing.checked);
      });

      trigger.addEventListener('click', () => {
        showBanner();
      });

      if (btnClose) {
        btnClose.addEventListener('click', () => {
          hideBanner();
          trigger.classList.remove('hidden');
        });
      }

    } catch (error) {
      console.error('Error inicializando el banner de cookies:', error);
    }
  }

  // Soporte para transiciones de Astro e inicialización estándar
  document.addEventListener('astro:page-load', initCookieBanner);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCookieBanner);
  } else {
    initCookieBanner();
  }
</script>
