---
export interface Props {
  schema: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { schema } = Astro.props;

function cleanObject(value: unknown): unknown {
  if (value === null || value === undefined || value === '') {
    return undefined;
  }
  if (Array.isArray(value)) {
    const cleanedArray = value.map(cleanObject).filter((item) => item !== undefined && item !== null && item !== '');
    return cleanedArray.length > 0 ? cleanedArray : undefined;
  }
  if (typeof value === 'object') {
    const cleanedObj: Record<string, unknown> = {};
    for (const [key, val] of Object.entries(value as Record<string, unknown>)) {
      const cleanedVal = cleanObject(val);
      if (cleanedVal !== undefined && cleanedVal !== null && cleanedVal !== '') {
        cleanedObj[key] = cleanedVal;
      }
    }
    return Object.keys(cleanedObj).length > 0 ? cleanedObj : undefined;
  }
  return value;
}

const cleanedSchema = cleanObject(schema);
const jsonString = cleanedSchema
  ? JSON.stringify(cleanedSchema).replace(/</g, '\\u003c').replace(/>/g, '\\u003e')
  : undefined;
---

{jsonString && <script type="application/ld+json" is:inline set:html={jsonString} />}
