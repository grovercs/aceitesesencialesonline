---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

export interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  id?: string;
}

const {
  title = 'Descarga GRATIS la Guía en PDF: Aceites Esenciales y Sus Usos',
  subtitle = 'Suscríbete gratis y recibe al instante en tu pantalla la guía imprimible de 3 páginas con la tabla de dilución y recomendaciones seleccionadas.',
  tagline = '🎁 Regalo Exclusivo para Suscriptores',
  id = 'newsletter',
} = Astro.props;
---

<WidgetWrapper id={id} containerClass="max-w-4xl mx-auto">
  <div class="rounded-3xl bg-gradient-to-br from-amber-500/10 via-emerald-500/5 to-slate-900/5 dark:from-amber-950/40 dark:via-emerald-950/20 dark:to-slate-900/60 border border-amber-200/80 dark:border-amber-900/40 p-6 md:p-10 shadow-lg relative overflow-hidden">
    
    <div class="absolute -top-12 -right-12 w-40 h-40 bg-amber-400/10 dark:bg-amber-400/5 rounded-full blur-2xl pointer-events-none"></div>

    <div class="text-center mb-6">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 border border-amber-300/50 dark:border-amber-800/60 text-xs font-bold uppercase tracking-wider mb-3">
        <Icon name="tabler:gift" class="w-4 h-4 text-amber-600 dark:text-amber-400" />
        {tagline}
      </span>
      <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight font-heading text-slate-900 dark:text-white mb-3 leading-tight">
        {title}
      </h2>
      <p class="text-base text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Beneficios clave de la Guía PDF -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-8 max-w-2xl mx-auto text-left text-xs font-medium text-slate-700 dark:text-slate-300">
      <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white/80 dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700/60">
        <Icon name="tabler:check" class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
        <span>Tabla de diluciones seguras (1%, 2% y 3-5%)</span>
      </div>
      <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white/80 dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700/60">
        <Icon name="tabler:check" class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
        <span>Ficha de los 10 aceites básicos y mezclas</span>
      </div>
      <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white/80 dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700/60">
        <Icon name="tabler:check" class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
        <span>Formato A4 descargable e imprimible</span>
      </div>
    </div>

    <form
      name="newsletter"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/gracias-newsletter/"
      class="mx-auto max-w-lg"
    >
      <input type="hidden" name="form-name" value="newsletter" />
      <p class="hidden">
        <label>No rellenes este campo: <input name="bot-field" /></label>
      </p>

      <div class="flex flex-col gap-3 sm:flex-row">
        <label for="email-newsletter" class="sr-only">Correo electrónico</label>
        <input
          id="email-newsletter"
          name="email"
          type="email"
          placeholder="Introduce tu correo electrónico..."
          required
          class="flex-1 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 shadow-sm"
        />
        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-amber-600 hover:bg-amber-700 dark:bg-amber-500 dark:hover:bg-amber-600 px-6 py-3 font-bold text-white text-sm transition shadow-md hover:shadow-lg shrink-0"
        >
          <Icon name="tabler:file-download" class="w-5 h-5" />
          Descargar PDF Gratis
        </button>
      </div>

      <p class="mt-4 text-[11px] text-center text-slate-500 dark:text-slate-400">
        🔒 100% Gratuito. Cero spam. Tu email está seguro y podrás darte de baja en 1 clic cuando quieras.
      </p>
    </form>
  </div>
</WidgetWrapper>
