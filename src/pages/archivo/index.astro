---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPublishedPosts } from '../../utils/content';

const allPosts = await getCollection('blog');
const posts = getPublishedPosts(allPosts).sort((a, b) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const grouped = posts.reduce((acc, post) => {
  const date = post.data.pubDate;
  const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
  if (!acc[key]) acc[key] = [];
  acc[key].push(post);
  return acc;
}, {});

const months = Object.keys(grouped).sort((a, b) => b.localeCompare(a));

const monthName = (key: string) => {
  const [year, month] = key.split('-');
  const date = new Date(Number(year), Number(month) - 1);
  return date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long' });
};

const title = 'Archivo del blog';
const description = 'Listado cronológico de todos los artículos publicados en Aceites Esenciales Online.';
---

<BaseLayout title={title} description={description} type="website">
  <Header />

  <main class="container mx-auto max-w-3xl px-4 py-12">
    <header class="mb-10 text-center">
      <h1 class="text-3xl font-extrabold text-gray-900 md:text-4xl">{title}</h1>
      <p class="mt-2 text-lg text-gray-600">{description}</p>
    </header>

    <div class="space-y-10">
      {
        months.map((key) => (
          <section>
            <h2 class="mb-4 border-b pb-2 text-xl font-bold text-gray-800">{monthName(key)}</h2>
            <ul class="space-y-3">
              {grouped[key].map((post) => (
                <li class="flex flex-col sm:flex-row sm:items-baseline sm:gap-4">
                  <time class="text-sm text-gray-500" datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('es-ES', {
                      day: 'numeric',
                      month: 'short',
                    })}
                  </time>
                  <a
                    href={`/blog/${post.id}/`}
                    class="font-medium text-gray-900 hover:text-green-700"
                  >
                    {post.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>

  <Footer />
</BaseLayout>
