---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getAllTags, getPublishedPosts, slugify } from '../../utils/content';

const allPosts = await getCollection('blog');
const posts = getPublishedPosts(allPosts);
const tags = getAllTags(posts);

const title = 'Etiquetas del blog';
const description = 'Explora todos los temas tratados en Aceites Esenciales Online: insomnio, lavanda, difusores, seguridad y mucho más.';
---

<BaseLayout title={title} description={description} type="website">
  <Header />

  <main class="container mx-auto max-w-4xl px-4 py-12">
    <header class="mb-10 text-center">
      <h1 class="text-3xl font-extrabold text-gray-900 md:text-4xl">{title}</h1>
      <p class="mt-2 text-lg text-gray-600">{description}</p>
    </header>

    <div class="flex flex-wrap justify-center gap-3">
      {
        tags.map((tag) => (
          <a
            href={`/etiquetas/${slugify(tag)}/`}
            class="rounded-full border border-green-200 bg-white px-5 py-2.5 text-base font-medium text-green-800 transition hover:bg-green-50"
          >
            #{tag}
          </a>
        ))
      }
    </div>
  </main>

  <Footer />
</BaseLayout>
