---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: '¡Gracias por suscribirte!',
  robots: {
    index: false,
    follow: true,
  },
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Volver al blog',
        href: '/blog/',
        icon: 'tabler:arrow-left',
      },
    ]}
  >
    <Fragment slot="title">¡Ya estás dentro!</Fragment>
    <Fragment slot="subtitle">
      Revisa tu correo para confirmar la suscripción. Pronto recibirás tu primera guía práctica de aromaterapia.
    </Fragment>
  </Hero>
</Layout>
