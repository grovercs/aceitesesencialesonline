---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: '¡Gracias por suscribirte!',
  robots: {
    index: false,
    follow: true,
  },
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: '📥 Abrir y Guardar Guía PDF Gratis',
        href: '/downloads/guia-aceites-esenciales.html',
        icon: 'tabler:file-download',
        target: '_blank',
      },
      {
        variant: 'secondary',
        text: 'Volver al blog',
        href: '/blog/',
        icon: 'tabler:arrow-left',
      },
    ]}
  >
    <Fragment slot="title">¡Gracias por suscribirte!</Fragment>
    <Fragment slot="subtitle">
      Tu suscripción está confirmada. Haz clic a continuación para abrir e imprimir tu <strong
        >Guía Práctica de Aceites Esenciales y Sus Usos (PDF Edición 2026)</strong
      >.
    </Fragment>
  </Hero>
</Layout>
