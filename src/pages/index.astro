---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(posts.map((post) => post.data.category))];
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  image={SITE.defaultImage}
  type="website"
>
  <Header />

  <main class="container mx-auto max-w-6xl px-4 py-12">
    <section class="mb-12 text-center">
      <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 md:text-5xl">
        Descubre el poder de los aceites esenciales
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
        Guías prácticas, comparativas honestas y recomendaciones de afiliados para mejorar tu
        bienestar de forma natural.
      </p>
    </section>

    {
      categories.length > 0 && (
        <section class="mb-10">
          <h2 class="mb-4 text-lg font-semibold text-gray-800">Explora por categoría</h2>
          <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
              <a
                href={`/categorias/${category.toLowerCase().replace(/\s+/g, '-')}/`}
                class="rounded-full border border-green-200 bg-white px-4 py-2 text-sm font-medium text-green-800 transition hover:bg-green-50"
              >
                {category}
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section>
      <h2 class="mb-6 text-2xl font-bold text-gray-900">Últimos artículos</h2>
      <div class="grid gap-8 md:grid-cols-2">
        {sortedPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
