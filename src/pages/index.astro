---
import Layout from '~/layouts/PageLayout.astro';

import HeroSlider from '~/components/widgets/HeroSlider.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Newsletter from '~/components/widgets/Newsletter.astro';
import ProductGrid from '~/components/affiliate/ProductGrid.astro';
import JsonLd from '~/components/common/JsonLd.astro';

const metadata = {
  title: 'Aceites Esenciales Online — Guías de aromaterapia y bienestar natural',
  ignoreTitleTemplate: true,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://aceitesesencialesonline.com/#website',
  url: 'https://aceitesesencialesonline.com/',
  name: 'Aceites Esenciales Online',
  inLanguage: 'es',
  publisher: {
    '@id': 'https://aceitesesencialesonline.com/#organization',
  },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://aceitesesencialesonline.com/#organization',
  name: 'Aceites Esenciales Online',
  url: 'https://aceitesesencialesonline.com/',
};
---

<Layout metadata={metadata}>
  <JsonLd schema={[websiteSchema, organizationSchema]} />
  <HeroSlider
    tagline="Aromaterapia Natural y Basada en Evidencia"
    interval={5500}
    slides={[
      {
        src: 'https://images.pexels.com/photos/9898737/pexels-photo-9898737.jpeg?auto=compress&cs=tinysrgb&w=1920',
        alt: 'Botella de aceite esencial con ramo de lavanda y velas sobre madera',
      },
      {
        src: 'https://images.unsplash.com/photo-1768159328330-813aca349881?auto=format&fit=crop&w=1920&q=80',
        alt: 'Campo de lavanda en flor bajo luz natural',
      },
      {
        src: 'https://images.unsplash.com/photo-1768877460519-f018f4e012a4?auto=format&fit=crop&w=1920&q=80',
        alt: 'Difusor de cristal con luces cálidas en ambiente relajante',
      },
      {
        src: 'https://images.unsplash.com/photo-1676803704427-496b1de33baa?auto=format&fit=crop&w=1920&q=80',
        alt: 'Botella de aceite esencial junto a flores frescas sobre mesa',
      },
    ]}
  >
    <Fragment slot="title">
      Bienestar natural con <span class="text-primary font-heading italic">aceites esenciales</span>
    </Fragment>

    <Fragment slot="subtitle">
      Guías prácticas, comparativas honestas y recomendaciones probadas para incorporar la aromaterapia con seguridad y
      armonía en tu hogar.
    </Fragment>

    <Fragment slot="actions">
      <div class="flex w-full sm:w-auto">
        <a
          href="/blog/"
          class="btn-primary w-full sm:mb-0 flex items-center gap-2 rounded-full bg-amber-500 px-6 py-3 text-sm font-bold text-white shadow-md transition hover:bg-amber-600"
        >
          🌿 Explorar guías
        </a>
      </div>
      <div class="flex w-full sm:w-auto">
        <a
          href="/blog/mejores-difusores-aceites-esenciales/"
          class="w-full sm:mb-0 flex items-center justify-center gap-2 rounded-full border border-white/60 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/20"
        >
          Ver difusores recomendados
        </a>
      </div>
    </Fragment>
  </HeroSlider>

  <Note
    title="Nuestra filosofía:"
    description="Contenido independiente, transparencia de afiliación y rigurosas pautas de seguridad."
  />

  <Features
    id="pilares"
    tagline="Explora por áreas temáticas"
    title="Todo lo necesario para empezar con tranquilidad"
    subtitle="Hemos estructurado la información en 3 grandes pilares para responder a tus dudas desde los principios fundamentales hasta el uso diario."
    columns={3}
    items={[
      {
        title: 'Fundamentos y Dilución',
        description:
          'Aprende a identificar aceites puros 100% naturales, entender las etiquetas de quimiotipo y diluirlos con seguridad.',
        icon: 'tabler:book-2',
      },
      {
        title: 'Bienestar y Salud Emocional',
        description:
          'Mejora tu sueño, reduce el estrés diario y crea mezclas de lavanda, bergamota o manzanilla para relajarte.',
        icon: 'tabler:moon-stars',
      },
      {
        title: 'Hogar y Difusores',
        description:
          'Comparativas de difusores ultrasónicos y por nebulización, cosmética artesanal y recetas de limpieza ecológica.',
        icon: 'tabler:home-2',
      },
    ]}
  />

  <Content
    isReversed
    tagline="Metodología Editorial"
    title="Recomendamos con criterio independiente"
    items={[
      {
        title: 'Contenido revisado y documentado',
        description: 'Combinamos la tradición botánica con la investigación actual sobre quimiotipos y precauciones.',
      },
      {
        title: 'Transparencia de afiliados',
        description:
          'Los enlaces a Amazon nos ayudan a financiar el sitio sin coste adicional para ti. Nunca cobramos por reseñas favorables.',
      },
      {
        title: 'Seguridad en niños y embarazo',
        description:
          'Indicamos claramente las dosis recomendadas, fototoxicidad de cítricos y contraindicaciones específicas.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1676803704427-496b1de33baa?auto=format&fit=crop&w=1024&q=80',
      alt: 'Botella de aceite esencial junto a flores frescas sobre mesa de madera',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2 font-heading">
        Tu portal independiente de aromaterapia
      </h3>
      No vendemos marca propia. Evaluamos los productos directamente en el mercado para recomendar únicamente lo que funciona.
    </Fragment>

    <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-amber-50/40 dark:bg-slate-900/40 border-y border-amber-200/40 dark:border-slate-800"
      >
      </div>
    </Fragment>
  </Content>

  <Steps
    title="Comienza con aromaterapia en 3 pasos"
    items={[
      {
        title: 'Paso 1: <span class="font-medium">Elige con conocimiento</span>',
        description: 'Identifica el nombre botánico en latín y exige aceites 100% puros de destilación limpia.',
        icon: 'tabler:search',
      },
      {
        title: 'Paso 2: <span class="font-medium">Diluye según la aplicación</span>',
        description:
          'Utiliza un aceite portador vegetal (jojoba, almendras) respetando la tasa de dilución del 1% al 3%.',
        icon: 'tabler:droplet',
      },
      {
        title: 'Paso 3: <span class="font-medium">Disfruta tu espacio</span>',
        description:
          'Difunde durante 20-30 minutos en sesiones intermitentes para ambientar tu estancia de forma saludable.',
        icon: 'tabler:plant',
      },
      {
        title: '¡Listo!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1768159328330-813aca349881?auto=format&fit=crop&w=1024&q=80',
      alt: 'Campo de lavanda en flor bajo cielo azul',
    }}
  />

  <BlogLatestPosts
    title="Últimas guías y artículos"
    information="Publicamos análisis semanales sobre aromaterapia, seguridad, difusores y usos terapéuticos."
  />

  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-7xl">
    <div class="text-center mb-10">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-600 dark:text-amber-400"
        >Selección Garantizada</span
      >
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading mt-1 mb-3">
        Productos más recomendados en Amazon
      </h2>
      <p class="text-lg text-muted dark:text-slate-400 max-w-2xl mx-auto">
        Kits de iniciación y difusores ultrasónicos altamente valorados por usuarios y entusiastas de la aromaterapia.
      </p>
    </div>
    <ProductGrid
      columns={3}
      products={[
        {
          title: 'doTERRA Family Essentials Kit',
          description:
            'El botiquín botánico familiar definitivo. Incluye los 10 aceites e infusiones CPTG indispensables en frascos de 5 ml y folleto oficial.',
          image: 'https://m.media-amazon.com/images/I/61roLT7bz4L._AC_UL320_.jpg',
          link: 'https://www.amazon.es/dp/B01N3JJXM5?tag=aceitesesen06-21',
          badge: 'Botiquín Familiar',
          buttonText: 'Ver precio y disponibilidad en Amazon',
        },
        {
          title: 'doTERRA Lavender Essential Oil (15 ml)',
          description:
            '100% puro y con certificación CPTG®. El aceite indispensable de aromaterapia para la calma mental, el descanso profundo y el cuidado cutáneo.',
          image: 'https://m.media-amazon.com/images/I/71MryMJYA2L._AC_UL320_.jpg',
          link: 'https://www.amazon.es/dp/B004O25R8A?tag=aceitesesen06-21',
          badge: 'Top Pureza CPTG®',
          buttonText: 'Ver precio y disponibilidad en Amazon',
        },
        {
          title: 'doTERRA Peppermint Essential Oil (15 ml)',
          description:
            'Aceite de Menta Piperita 100% puro. Energizante y refrescante natural, ideal para la concentración y aliviar tensiones.',
          image: 'https://m.media-amazon.com/images/I/41s0pFII1jL._AC_UL320_.jpg',
          link: 'https://www.amazon.es/dp/B01N4L50KI?tag=aceitesesen06-21',
          badge: 'Más Vendido',
          buttonText: 'Ver precio y disponibilidad en Amazon',
        },
      ]}
    />
    <p class="mt-8 text-xs text-center text-gray-400 dark:text-slate-500">
      Enlaces de afiliación. Comprar a través de Amazon ayuda a mantener la investigación independiente de Aceites
      Esenciales Online sin recargo alguno en tu pedido.
    </p>
  </section>

  <FAQs
    title="Preguntas frecuentes sobre aromaterapia"
    subtitle="Resolvemos las dudas principales para ayudarte a usar aceites esenciales con total tranquilidad."
    tagline="Transparencia y Seguridad"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '¿Son seguros los aceites esenciales para toda la familia?',
        description:
          'Sí, siempre que se utilicen correctamente. Es fundamental diluirlos en aceites vegetales portadores, respetar las dosis según la edad y consultar las advertencias en embarazadas o lactantes.',
      },
      {
        title: '¿Puedo usar cualquier aceite en un difusor ultrasónico?',
        description:
          'La gran mayoría de aceites puros destilados son perfectamente aptos. Se recomienda evitar resinas extremadamente densas no solubles y limpiar el aparato regularmente.',
      },
      {
        title: '¿Cuál es el mejor aceite esencial para dormir mejor?',
        description:
          'La lavanda (*Lavandula angustifolia*) es la variedad más respaldada clínicamente para inducir el descanso. La mejorana dulce y el azahar o bergamota son excelentes complementos.',
      },
      {
        title: '¿Cómo se financia este portal?',
        description:
          'Participamos en el Programa de Afiliados de Amazon. Si realizas una compra desde nuestras recomendaciones, Amazon nos abona una comisión sin modificar tu precio final.',
      },
    ]}
  />

  <Newsletter
    id="newsletter"
    tagline="Boletín de Salud Natural"
    title="Recibe guías prácticas en tu email"
    subtitle="Suscríbete para recibir recetas de mezclas aromáticas, alertas de ofertas en difusores y artículos sobre bienestar."
  />
</Layout>
